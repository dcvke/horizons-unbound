{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Huge dimensional storms with their own skies, worlds and stories.",
  "authors": ["dcvke"],
  "contact": {
    "homepage": "https://github.com/dcvke/horizons-unbound",
    "sources": "https://github.com/dcvke/horizons-unbound",
    "issues": "https://github.com/dcvke/horizons-unbound/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.horizonsunbound.fabric.FabricMod"],
    "client": ["com.horizonsunbound.fabric.FabricClient"],
    "fabric-gametest": ["com.horizonsunbound.fabric.FabricTests"]
  },
  "mixins": ["horizons_unbound.mixins.json", "horizons_unbound.fabric.mixins.json"],
  "accessWidener": "horizons_unbound.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": ">=${fabric_api_min_version}",
    "forgeconfigapiport": ">=${forge_config_api_port_version}"
  },
  "suggests": {"modmenu": "*"}
}
