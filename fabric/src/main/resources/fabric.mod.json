{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Huge dimensional storms roll across your world, bringing pieces of the End, the Nether, the Overworld and the Deep Dark with them.",
  "icon": "horizons_unbound.png",
  "authors": [
    "Meridusk"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.horizonsunbound.fabric.FabricMod"
    ],
    "client": [
      "com.horizonsunbound.fabric.FabricClient"
    ],
    "fabric-gametest": [
      "com.horizonsunbound.fabric.FabricTests"
    ],
    "modmenu": [
      "com.horizonsunbound.fabric.ModMenuIntegration"
    ],
    "journeymap": [
      "com.horizonsunbound.compat.JourneyMapMarks"
    ],
    "voicechat": [
      "com.horizonsunbound.compat.VoiceHearing"
    ]
  },
  "mixins": [
    "horizons_unbound.mixins.json",
    "horizons_unbound.fabric.mixins.json"
  ],
  "accessWidener": "horizons_unbound.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": ">=${fabric_api_min_version}",
    "forgeconfigapiport": ">=${forge_config_api_port_version}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "contact": {
    "homepage": "https://github.com/dcvke/horizons-unbound",
    "sources": "https://github.com/dcvke/horizons-unbound",
    "issues": "https://github.com/dcvke/horizons-unbound/issues"
  }
}
