  "cutscene.horizons_unbound.hands3": "Qu'est-ce qui m'ARRIVE ?",
  "cutscene.horizons_unbound.sky2": "Le ciel...",
  "cutscene.horizons_unbound.sky3": "Qu'est-ce qu'il a, le CIEL ?",
